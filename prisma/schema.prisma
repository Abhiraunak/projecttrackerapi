generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ProjectStatus {
  ONGOING
  COMPLETED
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  projects Project[]
  attendance Attendance[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String    // one login = one family; if an old token is replayed, the whole family is revoked
  tokenHash String    @unique // SHA-256 of the token. The raw token is never stored.
  authTime  DateTime  // when the user really typed their password; carried through every rotation
  expiresAt DateTime
  usedAt    DateTime? // set when this token has been exchanged for a new one
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}


model Project {
  id        String        @id @default(cuid())
  title     String
  status    ProjectStatus @default(ONGOING)
  ownerId   String
  owner     User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  attendance Attendance[]

  @@index([ownerId, status, updatedAt])
}

model Task {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  work           String
  area           Float
  contractorRate Float
  inHouseRate    Float
  stipulated     Decimal  @db.Decimal(14, 2)
  paid           Decimal  @default(0) @db.Decimal(14, 2)
  progress       Int      @default(0)
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId, position])
}

model Attendance {
  id             String             @id @default(cuid())
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  contractorName String
  date           DateTime           @db.Date
  extras         Decimal            @default(0) @db.Decimal(14, 2)
  notes          String             @default("")
  totalAmount    Decimal            @db.Decimal(14, 2) // always computed on the server
  workers        AttendanceWorker[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
}

model AttendanceWorker {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  label        String
  amount       Decimal    @db.Decimal(14, 2)
  position     Int        @default(0)

  @@index([attendanceId, position])
}