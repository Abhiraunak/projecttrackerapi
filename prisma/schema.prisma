generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  CLIENT // a customer: sees only the client portal for the projects they are linked to
}

enum ProjectStatus {
  ONGOING
  COMPLETED
  ARCHIVED
}

enum MovementType {
  RECEIVED
  ISSUED
  RESERVED
  RELEASED
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum BoqStatus {
  DRAFT
  FINAL
}

enum DrawingKind {
  IMAGE
  PDF
  CAD
}

enum StockAlertKind {
  ORDER_MORE // the BOQ still needs more than is in store or on order
  LOW_STOCK // the store is at or under the material's minimum while it is still needed
  LATE_DELIVERY // an order's expected date has passed with material still to come
}

enum MaterialRequestStatus {
  PENDING // waiting for approval
  APPROVED // approved: to be issued from the store, or ordered
  REJECTED
  CANCELLED
  ISSUED // issued from the store to its BOQ item
  ORDERED // an order was placed for it
}

model User {
  id                      String              @id @default(cuid())
  name                    String?
  email                   String              @unique
  passwordHash            String
  role                    Role                @default(USER)
  permissions             String[]            @default([])
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  projects                Project[]
  attendance              Attendance[]
  refreshTokens           RefreshToken[]
  drawings                Drawing[]
  drawingShares           DrawingShare[]
  pushSubscriptions       PushSubscription[]
  materials               Material[]
  vendors                 Vendor[]
  stockMovements          StockMovement[]
  materialOrders          MaterialOrder[]
  requestsMade            MaterialRequest[]   @relation("RequestedBy")
  requestsDecided         MaterialRequest[]   @relation("DecidedBy")
  auditEntries            AuditLog[]
  boqsCreated             Boq[]               @relation("BoqCreatedBy")
  boqsUpdated             Boq[]               @relation("BoqUpdatedBy")
  clientProjects          ProjectClient[]
  proofsUploaded          PaymentProof[]      @relation("ProofUploadedBy")
  proofsDecided           PaymentProof[]      @relation("ProofDecidedBy")
  delaysRecorded          ProjectDelay[]
  notifications           Notification[]
  punches                 StaffPunch[]
  deliveriesReceived      Delivery[]          @relation("DeliveryReceivedBy")
  deliveriesDecided       Delivery[]          @relation("DeliveryDecidedBy")
  equipmentAdded          Equipment[]         @relation("EquipmentAddedBy") // Phase 6
  equipmentMoves          EquipmentMove[]     @relation("EquipmentMovedBy")
  expensesAdded           Expense[]           @relation("ExpenseAddedBy")
  contractorPaymentsAdded ContractorPayment[] @relation("ContractorPaymentAddedBy")
  materialPaymentsAdded   MaterialPayment[]   @relation("MaterialPaymentAddedBy")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String // one login = one family; if an old token is replayed, the whole family is revoked
  tokenHash String    @unique // SHA-256 of the token. The raw token is never stored.
  authTime  DateTime // when the user really typed their password; carried through every rotation
  expiresAt DateTime
  usedAt    DateTime? // set when this token has been exchanged for a new one
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model Project {
  id                 String              @id @default(cuid())
  title              String
  firmName           String? // the firm or client name on the project tile (optional, so old rows need nothing)
  status             ProjectStatus       @default(ONGOING)
  ownerId            String
  owner              User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tasks              Task[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  projectCost        Decimal?            @db.Decimal(14, 2)
  attendance         Attendance[]
  stockMovements     StockMovement[]
  boqs               Boq[]
  boqItems           BoqItem[]
  materialOrders     MaterialOrder[]
  stockAlerts        StockAlert[]
  materialRequests   MaterialRequest[]
  auditLog           AuditLog[]
  // Client portal
  advanceOverride    Boolean             @default(false) // admin let work start before the advance was paid
  clients            ProjectClient[]
  instalments        PaymentInstalment[]
  paymentProofs      PaymentProof[]
  delays             ProjectDelay[]
  // Staff attendance: where the site is, so each punch can be checked against it (optional)
  siteLat            Float?
  siteLng            Float?
  siteRadiusM        Int                 @default(200)
  punches            StaffPunch[]
  deliveries         Delivery[]
  drawings           Drawing[] // Phase 4
  equipmentIn        EquipmentMove[]     @relation("EquipmentMoveTo") // Phase 6
  equipmentOut       EquipmentMove[]     @relation("EquipmentMoveFrom")
  expenses           Expense[] // daily expenditure
  contractorPayments ContractorPayment[]
  materialPayments   MaterialPayment[]

  @@index([ownerId, status, updatedAt])
}

model Task {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  work           String
  area           Float
  contractorRate Float
  inHouseRate    Float
  stipulated     Decimal  @db.Decimal(14, 2)
  paid           Decimal  @default(0) @db.Decimal(14, 2)
  progress       Int      @default(0)
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId, position])
}

model Attendance {
  id             String             @id @default(cuid())
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  contractorName String
  trade          String             @default("") // the trade or team: "Civil", "Tiles", "Fabrication"… empty: not set yet
  date           DateTime           @db.Date
  extras         Decimal            @default(0) @db.Decimal(14, 2)
  notes          String             @default("")
  totalAmount    Decimal            @db.Decimal(14, 2) // always computed on the server
  workers        AttendanceWorker[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([projectId, trade, date])
}

model AttendanceWorker {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  label        String
  amount       Decimal    @db.Decimal(14, 2)
  position     Int        @default(0)

  @@index([attendanceId, position])
}

model Drawing {
  id          String @id @default(cuid())
  ownerId     String
  owner       User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  description String @default("")

  // The image itself lives on Cloudinary. We keep only its reference and a few facts about it.
  publicId  String         @unique // Cloudinary's id: builds the links and deletes the file
  version   Int // changes if the file is ever replaced, so cached links stay correct
  format    String // png, jpg, webp, gif
  bytes     Int
  width     Int?
  height    Int?
  pages     Int?
  kind      DrawingKind    @default(IMAGE)
  shares    DrawingShare[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // Phase 4: drawings by project and number. All optional, so existing drawings need nothing until they are sorted.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  number    String? // "A-1.00", written one way (see drawings.calc.ts)
  revision  Int      @default(0) // R0 first issue, R1, R2…
  current   Boolean  @default(true) // false: replaced by a newer revision, kept as history

  @@unique([projectId, number, revision]) // two uploads of the same revision at once: one is refused
  @@index([ownerId, createdAt(sort: Desc)])
  @@index([projectId, current])
}

model DrawingShare {
  drawingId String
  drawing   Drawing  @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([drawingId, userId])
  @@index([userId, createdAt(sort: Desc)])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique // the push service address for this device: also identifies it
  p256dh    String // the device's encryption key
  auth      String // and its secret
  userAgent String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/**
 * ------------------------------- Inventory --------------------------------
 */

model Material {
  id            String               @id @default(cuid())
  ownerId       String
  owner         User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String
  unit          String // bag, kg, m3, nos...
  category      String               @default("General")
  minStock      Decimal              @default(0) @db.Decimal(14, 3) // at or under this the store is "low"
  rate          Decimal              @default(0) @db.Decimal(14, 2) // standard rate per unit, for the BOQ material budget
  movements     StockMovement[]
  itemMaterials BoqItemMaterial[]
  recipeLines   MaterialRecipeLine[]
  orders        MaterialOrder[]
  alerts        StockAlert[]
  requests      MaterialRequest[]
  deliveryLines DeliveryLine[]
  payments      MaterialPayment[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([ownerId, name])
}

model Vendor {
  id            String          @id @default(cuid())
  ownerId       String
  owner         User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String
  contactPerson String          @default("")
  phone         String          @default("")
  email         String          @default("")
  orders        MaterialOrder[]
  deliveries    Delivery[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([ownerId, name])
}

/// The stock log. Rows are only ever added, never edited: stock levels are worked out from it.
model StockMovement {
  id           String           @id @default(cuid())
  projectId    String
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materialId   String
  material     Material         @relation(fields: [materialId], references: [id], onDelete: Restrict)
  boqItemId    String? // the BOQ item it was issued or reserved for
  boqItem      BoqItem?         @relation(fields: [boqItemId], references: [id], onDelete: SetNull)
  orderId      String? // the order a delivery was received against
  order        MaterialOrder?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type         MovementType
  quantity     Decimal          @db.Decimal(14, 3) // always positive; the type says which way it goes
  note         String           @default("")
  createdById  String
  createdBy    User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  request      MaterialRequest? // the material request this issue fulfilled, if any
  deliveryLine DeliveryLine? // the checked delivery this stock came in on, if any
  createdAt    DateTime         @default(now())
  date         DateTime?        @db.Date
  vendorName   String           @default("")
  billId       String?
  billVersion  Int?
  billFormat   String?

  @@index([projectId, createdAt(sort: Desc)])
  @@index([projectId, materialId])
  @@index([boqItemId])
}

/// One priced part of one of the project's BOQs, as last synced. Never deleted by a sync: an item that left
/// the BOQ is marked inactive, so stock already issued to it keeps its history.
model BoqItem {
  id          String            @id @default(cuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqId       String?
  boq         Boq?              @relation(fields: [boqId], references: [id], onDelete: SetNull)
  partKey     String // the part's id inside the BOQ document
  sheetName   String            @default("")
  code        String            @default("")
  title       String
  matchText   String            @default("")
  contextText String            @default("")
  unit        String            @default("")
  quantity    Decimal           @db.Decimal(14, 3)
  position    Int               @default(0)
  active      Boolean           @default(true) // false: no longer in the BOQ
  noMaterials Boolean           @default(false) // reviewed: labour only (earthwork, shuttering...)
  suggested   Boolean           @default(false) // materials filled in from a recipe: to be checked
  recipeName  String            @default("") // the recipe that filled it, for display
  materials   BoqItemMaterial[]
  movements   StockMovement[]
  requests    MaterialRequest[]
  syncedAt    DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([projectId, boqId, partKey])
  @@index([projectId, position])
}

/// How much of one material one BOQ item needs per unit of the item
model BoqItemMaterial {
  id             String   @id @default(cuid())
  itemId         String
  item           BoqItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  materialId     String
  material       Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  perUnit        Decimal  @db.Decimal(14, 4)
  wastagePercent Decimal  @default(0) @db.Decimal(5, 2)
  position       Int      @default(0)

  @@unique([itemId, materialId])
}

/// Company-wide: the materials a kind of BOQ item needs per unit ("Concrete 1:2:4 (M15)": cement, sand, aggregate)
model MaterialRecipe {
  id        String               @id @default(cuid())
  name      String               @unique
  unit      String // the BOQ unit it applies to: cum, sqm, MT, kg...
  match     Json // [["1:2:4"], ["m15"]]: any group whose words all appear in the item's description
  lines     MaterialRecipeLine[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model MaterialRecipeLine {
  id             String         @id @default(cuid())
  recipeId       String
  recipe         MaterialRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  materialId     String
  material       Material       @relation(fields: [materialId], references: [id], onDelete: Restrict)
  perUnit        Decimal        @db.Decimal(14, 4)
  wastagePercent Decimal        @default(0) @db.Decimal(5, 2)
  position       Int            @default(0)

  @@unique([recipeId, materialId])
}

/// A purchase order for one material on one project. Deliveries are received against it.
model MaterialOrder {
  id               String            @id @default(cuid())
  projectId        String
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materialId       String
  material         Material          @relation(fields: [materialId], references: [id], onDelete: Restrict)
  vendorId         String?
  vendor           Vendor?           @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  quantity         Decimal           @db.Decimal(14, 3)
  receivedQty      Decimal           @default(0) @db.Decimal(14, 3)
  rate             Decimal           @default(0) @db.Decimal(14, 2) // agreed rate per unit on this order
  expectedDelivery DateTime?         @db.Date
  reference        String            @default("") // PO number
  note             String            @default("")
  createdById      String
  createdBy        User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  movements        StockMovement[]
  requests         MaterialRequest[]
  deliveryLines    DeliveryLine[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([projectId, createdAt(sort: Desc)])
  @@index([projectId, materialId])
}

/// An alert stays open while its condition holds; it is closed (resolvedAt) when the condition clears
model StockAlert {
  id         String         @id @default(cuid())
  projectId  String
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key        String // "order:<materialId>", "low:<materialId>", "late:<orderId>"
  kind       StockAlertKind
  materialId String?
  material   Material?      @relation(fields: [materialId], references: [id], onDelete: Cascade)
  orderId    String?
  message    String
  openedAt   DateTime       @default(now())
  resolvedAt DateTime?
  notifiedAt DateTime? // when a push went out for it

  @@index([projectId, resolvedAt])
  @@index([key, notifiedAt])
}

/// A request from site: "40 bags of cement for 5.3.9 footing by Friday"
model MaterialRequest {
  id            String                @id @default(cuid())
  projectId     String
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materialId    String
  material      Material              @relation(fields: [materialId], references: [id], onDelete: Restrict)
  boqItemId     String?
  boqItem       BoqItem?              @relation(fields: [boqItemId], references: [id], onDelete: SetNull)
  quantity      Decimal               @db.Decimal(14, 3)
  neededBy      DateTime?             @db.Date
  note          String                @default("")
  status        MaterialRequestStatus @default(PENDING)
  requestedById String
  requestedBy   User                  @relation("RequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedById   String?
  decidedBy     User?                 @relation("DecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  decisionNote  String                @default("")
  movementId    String?               @unique // the issue that fulfilled it
  movement      StockMovement?        @relation(fields: [movementId], references: [id], onDelete: SetNull)
  orderId       String? // the order placed for it
  order         MaterialOrder?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([projectId, status])
  @@index([projectId, createdAt(sort: Desc)])
}

/**
 * --------------------------------- Audit ----------------------------------
 */

model AuditLog {
  id         String   @id @default(cuid())
  projectId  String? // empty for changes that belong to no project (BOQs, who may do what)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String // kept as text, so the entry still names the person if the account is deleted later
  action     String // "materials.imported"
  entityType String // project, task, requirement, stock, attendance, user, boq
  entityId   String?
  summary    String // a sentence for people to read
  changes    Json? // { "receivedQty": { "from": 0, "to": 210 } }
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt(sort: Desc)])
  @@index([projectId, entityType])
  @@index([createdAt(sort: Desc)])
}

/**
 * ---------------------------------- BOQ -----------------------------------
 */

model Boq {
  id          String    @id @default(cuid())
  title       String    @default("")
  subtitle    String    @default("")
  boqNumber   String    @default("")
  status      BoqStatus @default(DRAFT)
  grandTotal  Decimal   @default(0) @db.Decimal(16, 2) // worked out by the server from the document
  itemCount   Int       @default(0)
  document    Json
  version     Int       @default(1) // goes up on every save; a save from an older version is refused
  projectId   String? // the project whose materials this BOQ feeds
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  boqItems    BoqItem[]
  createdById String?
  createdBy   User?     @relation("BoqCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?     @relation("BoqUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([updatedAt(sort: Desc)])
  @@index([status])
  @@index([projectId])
}

/**
 * ------------------------------- client portal -------------------------------
 */

enum InstalmentKind {
  ADVANCE // asked for before work starts
  INSTALMENT
}

enum PaymentMode {
  UPI
  BANK_TRANSFER
  CHEQUE
  CASH
  OTHER
}

enum ProofStatus {
  PENDING // the client sent it; an admin hasn't checked it yet
  APPROVED // the money arrived: counts as paid
  REJECTED
}

enum DelayReason {
  MONSOON
  FESTIVAL
  NATURAL // flood, storm, heat wave and the like
  OTHER
}

/**
 * A client account linked to a project: they see that project in the client portal, nothing else
 */
model ProjectClient {
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
}

/**
 * One payment the client owes: the advance or an instalment. Each one is also an invoice (INV-<number>).
 */
model PaymentInstalment {
  id            String         @id @default(cuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number        Int // 1, 2, 3… within the project: the invoice number
  label         String // "Advance", "Plinth complete"
  kind          InstalmentKind @default(INSTALMENT)
  amount        Decimal        @db.Decimal(14, 2) // before tax
  taxPercent    Decimal        @default(0) @db.Decimal(5, 2) // GST
  dueDate       DateTime?      @db.Date // due on this date…
  dueAtProgress Int? // …or once the work reaches this % (whichever comes first)
  requestedAt   DateTime? // the admin asked for it now: due from then
  note          String         @default("")
  proofs        PaymentProof[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([projectId, number])
  @@index([projectId, dueDate])
}

/**
 * A payment against an instalment: a screenshot or PDF the client uploaded, or one the admin recorded directly
 */
model PaymentProof {
  id           String            @id @default(cuid())
  instalmentId String
  instalment   PaymentInstalment @relation(fields: [instalmentId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User              @relation("ProofUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  amount       Decimal           @db.Decimal(14, 2)
  paidOn       DateTime          @db.Date
  mode         PaymentMode
  reference    String            @default("") // UTR / cheque number
  note         String            @default("")
  // The file on Cloudinary (none when the admin records a payment by hand)
  publicId     String?           @unique
  version      Int?
  format       String?
  bytes        Int?
  status       ProofStatus       @default(PENDING)
  decidedById  String?
  decidedBy    User?             @relation("ProofDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String            @default("")
  createdAt    DateTime          @default(now())

  @@index([projectId, status])
  @@index([status, createdAt])
  @@index([instalmentId])
}

/**
 * Work stopped for a reason nobody controls. Recording one moves the remaining work and unpaid due dates later.
 */
model ProjectDelay {
  id            String      @id @default(cuid())
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reason        DelayReason
  title         String // "Heavy monsoon rain", "Diwali holidays"
  note          String      @default("")
  fromDate      DateTime    @db.Date
  days          Int
  tasksMoved    Int         @default(0)
  paymentsMoved Int         @default(0)
  createdById   String
  createdBy     User        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now())

  @@index([projectId, createdAt])
}

/**
 * The bell list: what happened that this person should know (a copy is also pushed to their phone, if they turned that on)
 */
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String? // set for reminders, so the same reminder is never sent twice ("overdue:<id>:1")
  title     String
  body      String
  url       String // where tapping it goes
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, key])
  @@index([userId, createdAt(sort: Desc)])
}

/**
 * ----------------------------- staff attendance -----------------------------
 */

enum PunchType {
  IN
  OUT
}

/**
 * One punch in or out by a staff member: the server's time, a photo, and where the phone was
 */
model StaffPunch {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        PunchType
  at          DateTime  @default(now()) // the server's clock, never the phone's
  projectId   String? // the site they punched at
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  place       String    @default("") // when not at a project: another place or a vehicle number
  note        String    @default("")
  // Where the phone was (none when the person didn't allow location)
  lat         Float?
  lng         Float?
  accuracyM   Float?
  plusCode    String?
  distanceM   Int? // from the project's site, when the site's location is set
  outsideSite Boolean   @default(false)
  // The verification photo on Cloudinary
  publicId    String    @unique
  version     Int
  format      String
  userAgent   String    @default("")
  createdAt   DateTime  @default(now())

  @@index([userId, at(sort: Desc)])
  @@index([at])
}

/**
 * ------------------------------- delivery check-in -------------------------------
 */

enum DeliveryStatus {
  ACCEPTED // matched and on site: added to stock at once
  PENDING // flagged: waiting for someone who can approve deliveries
  APPROVED // flagged, then approved: added to stock
  REJECTED // flagged, then rejected: nothing added
}

enum LocationCheck {
  ON_SITE
  OFF_SITE
  NO_LOCATION // the phone didn't share its location
  SITE_NOT_SET // the project's site location isn't set, so it couldn't be checked
}

/**
 * A delivery checked in at site: what was expected, what came, photos taken there, and the decision
 */
model Delivery {
  id            String          @id @default(cuid())
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorId      String?
  vendor        Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  challanNo     String          @default("") // delivery challan / invoice number
  vehicleNo     String          @default("")
  note          String          @default("")
  status        DeliveryStatus
  locationCheck LocationCheck
  distanceM     Int? // the furthest photo from the site
  flags         String[]        @default([]) // why it needs approval, in words
  receivedById  String
  receivedBy    User            @relation("DeliveryReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  decidedById   String?
  decidedBy     User?           @relation("DeliveryDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  decisionNote  String          @default("")
  lines         DeliveryLine[]
  photos        DeliveryPhoto[]
  createdAt     DateTime        @default(now())

  @@index([projectId, createdAt(sort: Desc)])
  @@index([status, createdAt])
}

model DeliveryLine {
  id          String         @id @default(cuid())
  deliveryId  String
  delivery    Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  orderId     String
  order       MaterialOrder  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  materialId  String
  material    Material       @relation(fields: [materialId], references: [id], onDelete: Restrict)
  expectedQty Decimal        @db.Decimal(14, 3) // still to come on the order when it arrived
  receivedQty Decimal        @db.Decimal(14, 3)
  condition   String         @default("") // "2 bags torn"
  movementId  String?        @unique // the stock entry, once it is added
  movement    StockMovement? @relation(fields: [movementId], references: [id], onDelete: SetNull)

  @@index([deliveryId])
}

/**
 * A photo of the delivery, taken with the phone's camera in the app (never picked from the gallery)
 */
model DeliveryPhoto {
  id         String   @id @default(cuid())
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  publicId   String   @unique
  version    Int
  format     String
  lat        Float?
  lng        Float?
  accuracyM  Float?
  plusCode   String?
  distanceM  Int?
  takenAt    DateTime // when the phone says it was taken
  createdAt  DateTime @default(now())

  @@index([deliveryId])
}

// ---------------------------------------------------------------------------------------------------------------
// Phase 6: equipment register. Shuttering, machinery and the like, and where every piece is.
// Quantities are never stored as a number to edit: each change is a move (bought, sent, returned, written off),
// and "how many where" is worked out from the moves. So the history always explains the numbers.
// ---------------------------------------------------------------------------------------------------------------

model Equipment {
  id            String          @id @default(cuid())
  serialNo      Int             @unique @default(autoincrement()) // EQ-0001…
  name          String // "Steel plates 2×1 ft", "Concrete mixer"
  category      String          @default("other") // "shuttering" | "scaffolding" | "machinery" | "tools" | "other"
  unit          String          @default("nos") // nos, sets, sq m, rft
  code          String? // tag or serial number, for machines
  ownership     String          @default("owned") // "owned" | "hired"
  hireRate      Decimal?        @db.Decimal(12, 2) // per unit, per hirePer (hired items)
  hirePer       String          @default("day") // "day" | "month"
  supplier      String? // who it is hired or bought from
  unitCost      Decimal?        @db.Decimal(14, 2) // cost of one unit
  marketValue   Decimal?        @db.Decimal(14, 2) // what one unit is worth today
  marketValueOn DateTime?       @db.Date // when that value was last set
  serviceDue    DateTime?       @db.Date // machines: next service
  notes         String          @default("")
  retired       Boolean         @default(false) // nothing left and not used any more: hidden from pickers
  addedById     String
  addedBy       User            @relation("EquipmentAddedBy", fields: [addedById], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  moves         EquipmentMove[]

  @@index([category, retired])
}

model EquipmentMove {
  id            String    @id @default(cuid())
  equipmentId   String
  equipment     Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  kind          String // "add" (bought / hired in), "move" (between yard and sites), "write_off" (lost, scrapped, returned to the hirer)
  // Empty means the yard (the company's store). If a project is deleted, what was there counts as back in the yard.
  fromProjectId String?
  fromProject   Project?  @relation("EquipmentMoveFrom", fields: [fromProjectId], references: [id], onDelete: SetNull)
  toProjectId   String?
  toProject     Project?  @relation("EquipmentMoveTo", fields: [toProjectId], references: [id], onDelete: SetNull)
  quantity      Decimal   @db.Decimal(12, 2)
  date          DateTime  @db.Date
  condition     String    @default("good") // "good" | "repair" | "damaged": the state it arrived in
  note          String    @default("")
  byId          String
  by            User      @relation("EquipmentMovedBy", fields: [byId], references: [id])
  createdAt     DateTime  @default(now())

  @@index([equipmentId, date])
  @@index([toProjectId])
  @@index([fromProjectId])
}

// Daily expenditure on a project: money paid for anything (transport, tea, small tools…), with the bill if there is one
model Expense {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    String   @default("general") // "general" | "labour" | "material"
  date        DateTime @db.Date
  amount      Decimal  @db.Decimal(14, 2)
  purpose     String
  remark      String   @default("")
  // The bill (a photo or PDF), stored on Cloudinary like drawings; all empty when there is no bill
  billId      String?
  billVersion Int?
  billFormat  String?
  addedById   String
  addedBy     User     @relation("ExpenseAddedBy", fields: [addedById], references: [id])
  createdAt   DateTime @default(now())

  @@index([projectId, date])
  @@index([projectId, category, date])
}

model ContractorPayment {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  trade          String   @default("")
  contractorName String
  date           DateTime @db.Date
  amount         Decimal  @db.Decimal(14, 2)
  remark         String   @default("")
  proofId        String?
  proofVersion   Int?
  proofFormat    String?
  addedById      String
  addedBy        User     @relation("ContractorPaymentAddedBy", fields: [addedById], references: [id])
  createdAt      DateTime @default(now())

  @@index([projectId, date])
  @@index([projectId, trade, contractorName])
}

model MaterialPayment {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorName   String
  materialId   String?
  material     Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  date         DateTime  @db.Date
  amount       Decimal   @db.Decimal(14, 2)
  remark       String    @default("")
  proofId      String?
  proofVersion Int?
  proofFormat  String?
  addedById    String
  addedBy      User      @relation("MaterialPaymentAddedBy", fields: [addedById], references: [id])
  createdAt    DateTime  @default(now())

  @@index([projectId, date])
  @@index([projectId, vendorName])
}
