generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ProjectStatus {
  ONGOING
  COMPLETED
  ARCHIVED
}

enum MovementType {
  RECEIVED
  ISSUED
  RESERVED
  RELEASED
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum BoqStatus {
  DRAFT
  FINAL
}

enum DrawingKind {
  IMAGE
  PDF
  CAD
}

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String             @unique
  passwordHash      String
  role              Role               @default(USER)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  projects          Project[]
  attendance        Attendance[]
  refreshTokens     RefreshToken[]
  drawings          Drawing[]
  drawingShares     DrawingShare[]
  pushSubscriptions PushSubscription[]
  materials         Material[]
  vendors           Vendor[]
  stockMovements    StockMovement[]
  auditEntries      AuditLog[]
  boqsCreated       Boq[]              @relation("BoqCreatedBy")
  boqsUpdated       Boq[]              @relation("BoqUpdatedBy")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String // one login = one family; if an old token is replayed, the whole family is revoked
  tokenHash String    @unique // SHA-256 of the token. The raw token is never stored.
  authTime  DateTime // when the user really typed their password; carried through every rotation
  expiresAt DateTime
  usedAt    DateTime? // set when this token has been exchanged for a new one
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model Project {
  id             String          @id @default(cuid())
  title          String
  status         ProjectStatus   @default(ONGOING)
  ownerId        String
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tasks          Task[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  projectCost    Decimal?        @db.Decimal(14, 2)
  attendance     Attendance[]
  requirements   Requirement[]
  stockMovements StockMovement[]
  auditLog       AuditLog[]

  @@index([ownerId, status, updatedAt])
}

model Task {
  id             String          @id @default(cuid())
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  work           String
  area           Float
  contractorRate Float
  inHouseRate    Float
  stipulated     Decimal         @db.Decimal(14, 2)
  paid           Decimal         @default(0) @db.Decimal(14, 2)
  progress       Int             @default(0)
  startDate      DateTime        @db.Date
  endDate        DateTime        @db.Date
  position       Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  requirements   Requirement[]
  stockMovements StockMovement[]

  @@index([projectId, position])
}

model Attendance {
  id             String             @id @default(cuid())
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  contractorName String
  date           DateTime           @db.Date
  extras         Decimal            @default(0) @db.Decimal(14, 2)
  notes          String             @default("")
  totalAmount    Decimal            @db.Decimal(14, 2) // always computed on the server
  workers        AttendanceWorker[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
}

model AttendanceWorker {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  label        String
  amount       Decimal    @db.Decimal(14, 2)
  position     Int        @default(0)

  @@index([attendanceId, position])
}

model Drawing {
  id          String @id @default(cuid())
  ownerId     String
  owner       User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  description String @default("")

  // The image itself lives on Cloudinary. We keep only its reference and a few facts about it.
  publicId  String         @unique // Cloudinary's id: builds the links and deletes the file
  version   Int // changes if the file is ever replaced, so cached links stay correct
  format    String // png, jpg, webp, gif
  bytes     Int
  width     Int?
  height    Int?
  pages     Int?
  kind      DrawingKind    @default(IMAGE)
  shares    DrawingShare[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([ownerId, createdAt(sort: Desc)])
}

model DrawingShare {
  drawingId String
  drawing   Drawing  @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([drawingId, userId])
  @@index([userId, createdAt(sort: Desc)])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique // the push service address for this device: also identifies it
  p256dh    String // the device's encryption key
  auth      String // and its secret
  userAgent String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Material {
  id           String          @id @default(cuid())
  ownerId      String
  owner        User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  unit         String // bag, kg, m3, nos...
  category     String          @default("General")
  minStock     Decimal         @default(0) @db.Decimal(14, 3) // at or under this the store is "low"
  requirements Requirement[]
  movements    StockMovement[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([ownerId, name])
}

model Vendor {
  id            String        @id @default(cuid())
  ownerId       String
  owner         User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String
  contactPerson String        @default("")
  phone         String        @default("")
  email         String        @default("")
  requirements  Requirement[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([ownerId, name])
}

/// One material needed by one work item, and how far its ordering has got
model Requirement {
  id               String          @id @default(cuid())
  projectId        String
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId           String
  task             Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  materialId       String
  material         Material        @relation(fields: [materialId], references: [id], onDelete: Restrict)
  vendorId         String?
  vendor           Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  requiredQty      Decimal         @db.Decimal(14, 3) // before wastage
  wastagePercent   Decimal         @default(5) @db.Decimal(5, 2)
  orderedQty       Decimal         @default(0) @db.Decimal(14, 3)
  receivedQty      Decimal         @default(0) @db.Decimal(14, 3)
  expectedDelivery DateTime?       @db.Date
  requested        Boolean         @default(false) // a request is raised and waiting for approval
  movements        StockMovement[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([taskId, materialId])
  @@index([projectId])
}

/// The stock log. Rows are only ever added, never edited: stock levels are worked out from it.
model StockMovement {
  id            String       @id @default(cuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materialId    String
  material      Material     @relation(fields: [materialId], references: [id], onDelete: Restrict)
  taskId        String?
  task          Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  requirementId String?
  requirement   Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  type          MovementType
  quantity      Decimal      @db.Decimal(14, 3) // always positive; the type says which way it goes
  note          String       @default("")
  createdById   String
  createdBy     User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime     @default(now())

  @@index([projectId, createdAt(sort: Desc)])
  @@index([projectId, materialId])
}

model AuditLog {
  id         String   @id @default(cuid())
  projectId  String? // empty for changes that belong to no project (BOQs, who may do what)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String // kept as text, so the entry still names the person if the account is deleted later
  action     String // "requirement.order_updated"
  entityType String // project, task, member, requirement, stock, attendance, user, boq
  entityId   String?
  summary    String // a sentence for people to read
  changes    Json? // { "orderedQty": { "from": 0, "to": 210 } }
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt(sort: Desc)])
  @@index([projectId, entityType])
  @@index([createdAt(sort: Desc)])
}

model Boq {
  id          String    @id @default(cuid())
  title       String    @default("")
  subtitle    String    @default("")
  boqNumber   String    @default("")
  status      BoqStatus @default(DRAFT)
  grandTotal  Decimal   @default(0) @db.Decimal(16, 2) // worked out by the server from the document
  itemCount   Int       @default(0)
  document    Json
  version     Int       @default(1) // goes up on every save; a save from an older version is refused
  createdById String?
  createdBy   User?     @relation("BoqCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?     @relation("BoqUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([updatedAt(sort: Desc)])
  @@index([status])
}
